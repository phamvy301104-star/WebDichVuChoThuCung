# Sao chép file này thành .env.local và điền vào các giá trị
# Copy this file to .env.local and fill in the values

# Google OAuth (tùy chọn - không bắt buộc)
# Lấy từ: https://console.cloud.google.com -> APIs & Services -> Credentials
# Nếu để trống, nút "Đăng nhập bằng Google" vẫn hiển thị nhưng sẽ thông báo chưa cấu hình
VITE_GOOGLE_CLIENT_ID=

# Backend API URL
VITE_API_URL=http://localhost:3000
