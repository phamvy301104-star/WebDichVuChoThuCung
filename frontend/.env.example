# Sao chép file này thành .env.local và điền vào các giá trị

# Google OAuth (tùy chọn)
VITE_GOOGLE_CLIENT_ID=

# Hugging Face API Key (tùy chọn - tăng độ chính xác AI nhận diện)
# Lấy miễn phí tại: https://huggingface.co/settings/tokens
VITE_HF_API_KEY=

# Backend API URL
VITE_API_URL=http://localhost:3000
